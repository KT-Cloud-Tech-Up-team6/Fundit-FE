# API, LIVE, 결제 계약이 확정되면 비밀값 없이 변수 이름만 추가합니다.

# PortOne 본인인증. 값은 NEXT_PUBLIC_ 접두사라 브라우저에 노출되는 공개 식별자다.
# 로컬은 .env.local, 배포 이미지는 동일 이름의 GitHub Repository Variables를 사용합니다.
# 값을 변경하면 재빌드·재배포해야 합니다. 서버 API Secret을 넣지 않습니다.
# 개발 모드에서 MSW를 명시적으로 켠 경우에만 설정 누락 시 모의 인증을 사용합니다.
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=

# Toss 결제위젯 클라이언트 키(test_gck_… / live_gck_…). NEXT_PUBLIC_ 접두사라 브라우저에 노출되는 공개 키다.
# BE가 승인에 쓰는 위젯 시크릿 키와 같은 상점의 "결제위젯 연동 키" 페어여야 한다. 비어 있으면 결제 화면이 비활성화된다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# 소셜 로그인 client ID. NEXT_PUBLIC_ 접두사라 브라우저에 노출되는 공개값이다. client secret은 BE만 쓰므로 넣지 않는다.
# 카카오는 REST API 키다. BE가 코드 교환에 쓰는 앱과 같은 앱의 ID여야 한다. 값이 비어 있으면 소셜 버튼이 비활성이다.
# redirect URI는 `<origin>/oauth/kakao`, `<origin>/oauth/google`이며 각 콘솔과 BE의 KAKAO_REDIRECT_URI, GOOGLE_REDIRECT_URI에 같은 값이 등록돼 있어야 한다.
# 개발 모드에서 MSW를 명시적으로 켠 경우에만 값이 없어도 목업 인가 코드로 콜백에 바로 간다.
NEXT_PUBLIC_KAKAO_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# 실제 BE 연동 시 false, 로컬 목업 사용 시 true.
NEXT_PUBLIC_MSW_ENABLED=false
NEXT_PUBLIC_API_BASE_URL=
